# Dependencies — restored by `make install`, never committed.
backend/.venv/
frontend/node_modules/
frontend/.next/
frontend/out/

# Secrets. `.env.example` on both sides is committed and is the documentation.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
*.egg-info/

# Editors and OS
.DS_Store
.idea/
.vscode/

# Local capture output, if anything is ever written outside object storage.
/tmp/
scratch/

# Credential vault: session cookies, CSRF tokens, whatever a login produced.
# On disk so the services work; never in history.
backend/.sro-vault
backend/worker.log
