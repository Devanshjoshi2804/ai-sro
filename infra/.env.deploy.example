# Copy per environment and fill in. Never commit a filled copy.
#
#     cp infra/.env.deploy.example infra/.env.qa
#     docker compose -f infra/docker-compose.deploy.yml --env-file infra/.env.qa up -d
#
# QA first, and QA is the shape production will be: it is what a client is
# shown and what gets tested, so it runs the same compose file, the same
# images and the same switches. What differs between the two files is the
# hostnames, the secrets, and nothing else.
#
# Every variable below without a default is `${VAR:?}` in the compose file: the
# stack refuses to start and names the one that is missing, rather than booting
# with a guess.

# Which environment this file describes. Only `local` has behaviour attached
# (it opens CORS to localhost:3000), so `qa` and `production` behave the same
# -- but `/health` reports it, and a trace nobody can place is a trace nobody
# can act on.
SRO_ENVIRONMENT=qa

# -- what to run -------------------------------------------------------------
# Tag images with the commit they were built from, and deploy by digest or tag.
# `latest` makes "which code is running" unanswerable, which is the question
# every incident starts with.
# Promote these tags unchanged from QA to production when QA passes. Building
# again for production ships an image nothing tested.
BACKEND_IMAGE=ai-sro-backend:CHANGE-ME
WEB_IMAGE=ai-sro-web:CHANGE-ME

# -- secrets -----------------------------------------------------------------
# Generate once, keep out of git, and do not rotate casually:
#   SRO_AUTH_SECRET  rotating it invalidates every credential every operator
#                    has pasted into their extension.  `make auth-secret`
#   SRO_VAULT_KEY    rotating it makes every stored system credential
#                    unreadable.  `make vault-key`
SRO_AUTH_SECRET=
SRO_VAULT_KEY=

POSTGRES_USER=sro
POSTGRES_PASSWORD=
POSTGRES_DB=sro

S3_ACCESS_KEY=sro
S3_SECRET_KEY=
S3_BUCKET=sro-artifacts

# -- where this deployment lives ---------------------------------------------
# One origin in front of the console, the API and the artifacts. This is the
# only thing an operator's browser talks to, and the only port the
# application publishes. See infra/Caddyfile.
PUBLIC_BIND=0.0.0.0:8088

# The urls operators' browsers actually use. Not internal service names: these
# are compared against what the extension reports seeing, and they are how the
# system knows its own traffic is not warehouse work.
SRO_API_URL=http://10.11.9.25:8088/api
SRO_CONSOLE_URL=http://10.11.9.25:8088

# JSON array. The console is same-origin with the API now and does not belong
# here. A `chrome-extension://` origin is cross-origin however it is served,
# and still does.
SRO_CORS_ORIGINS=["chrome-extension://onfmljaebeipeiinflhgdochbcjeoehl","chrome-extension://fokdlimdngfkjpnpeogpeeldcoikabpj"]

# Where a browser reaches object storage: the proxy, which forwards
# `/sro-artifacts/*` to MinIO with the path and the Host untouched. A
# presigned url signs both, so neither may be rewritten on the way through.
SRO_S3_PUBLIC_ENDPOINT_URL=http://10.11.9.25:8088

# Where a person's browser can reach Steel's session viewer. Steel builds the
# urls it hands out from this, so an internal name here is a live view stuck on
# "Session connecting..." forever. Still published on its own rather than
# proxied: it is a whole UI with its own websockets and absolute paths. Its CDP
# port is deliberately not published -- only the API attaches to it, and an
# open DevTools port is full control of a browser holding warehouse
# credentials.
STEEL_DOMAIN=10.11.9.25:3010
STEEL_BIND=0.0.0.0:3010

# -- hosted models -----------------------------------------------------------
# Off unless turned on, per destination. A key is not consent: see
# `docs/10-security-and-data.md`. Without an interpreter the system still
# mines, still offers and still teaches -- it gets duller sentences.
SRO_GEMINI_API_KEY=
SRO_INTERPRETATION_ENABLED=false
SRO_TRANSCRIPTION_ENABLED=false
SRO_VISION_ENABLED=false
SRO_KNOWLEDGE_EMBEDDINGS_ENABLED=false

# -- Nango (docs/18-deployment.md "Nango") ------------------------------------
# Encrypts the provider tokens Nango stores. `openssl rand -base64 32`. Losing
# or changing it makes every stored connection unreadable.
NANGO_ENCRYPTION_KEY=
# Nango's own Postgres role (owns only the `nango` database). Created by
# init-db.sh on a fresh volume; by hand on an existing one (docs/18-deployment.md).
NANGO_DB_USER=nango
NANGO_DB_PASSWORD=
# Where the operator's BROWSER reaches Nango's dashboard/API and Connect UI.
# The OAuth callback is NANGO_PUBLIC_URL + /oauth/callback and must be a redirect
# URI the provider accepts: an https hostname, or http://localhost:8089 with an
# SSH tunnel (docs/18-deployment.md "Nango").
NANGO_PUBLIC_URL=http://localhost:8089
NANGO_PUBLIC_CONNECT_URL=http://localhost:8082
# Both ports bind to loopback; reach them by SSH tunnel. Use 0.0.0.0:<port> only
# once TLS and a hostname exist (the dashboard is plain HTTP otherwise).
NANGO_BIND=127.0.0.1:8089
NANGO_CONNECT_BIND=127.0.0.1:8082
# Basic auth on the dashboard.
NANGO_DASHBOARD_USERNAME=
NANGO_DASHBOARD_PASSWORD=
# How the backend reaches Nango, and the environment secret key from the
# dashboard (Environment Settings). Blank until Nango is up and the key copied.
SRO_NANGO_URL=http://nango-server:8080
SRO_NANGO_SECRET_KEY=
# Integrations the Connections page offers (JSON list of Nango integration ids).
SRO_INTEGRATIONS=["microsoft"]
# Signs the per-operator key the mail connector accepts after an account is linked;
# the Outlook connector gets the same value as CONNECTOR_SIGNING_KEY. Blank = Link answers 503; a set key must be at least 32 bytes.
# Generate: openssl rand -hex 32
SRO_CONNECTOR_SIGNING_KEY=
