# Copy to .env. Every variable is optional; the defaults match infra/docker-compose.yml.
SRO_ENVIRONMENT=local
SRO_DEBUG=false

SRO_DATABASE_URL=postgresql+asyncpg://sro:sro@localhost:5432/sro

SRO_S3_ENDPOINT_URL=http://localhost:9000
SRO_S3_ACCESS_KEY=sro
SRO_S3_SECRET_KEY=sro-secret
SRO_S3_BUCKET=sro-artifacts

SRO_STEEL_BASE_URL=http://localhost:3010
SRO_STEEL_CDP_URL=http://localhost:9223

SRO_TEMPORAL_ADDRESS=localhost:7233
SRO_OTLP_ENDPOINT=http://localhost:4318

# Payloads above this go to object storage; nothing is discarded either way.
SRO_INLINE_BODY_LIMIT_BYTES=262144

# A browser the operator already has open, driven at L2. Empty means no UI rung.
SRO_UI_DEBUGGER_URL=

# Narration leaves the deployment, so it takes both of these, not one: a key is
# not by itself a decision to send a customer's operators' voices to Google.
SRO_TRANSCRIPTION_ENABLED=false
SRO_GEMINI_API_KEY=

# Embeddings order what a structured filter already chose. Off by default:
# retrieval works without them, and turning them on sends the knowledge base's
# titles to a hosted model.
SRO_KNOWLEDGE_EMBEDDINGS_ENABLED=false
SRO_GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# L3 sends a screenshot of the live WMS to Google. Separate switch from the key,
# because that is a different decision from transcribing narration.
SRO_VISION_ENABLED=false

# Reading one demonstration as a workflow sends its calls and bodies to a
# hosted model. A key is not consent; this is its own switch.
SRO_INTERPRETATION_ENABLED=false

# Signs this deployment own credentials. Generate with make auth-secret.
# Unset, every authenticated endpoint answers 503 rather than letting anything through.
SRO_AUTH_SECRET=

# Browser origins allowed to call this API beyond the local console. The
# extension's id is pinned by its manifest key, so this is the same everywhere.
SRO_CORS_ORIGINS=["chrome-extension://onfmljaebeipeiinflhgdochbcjeoehl"]
